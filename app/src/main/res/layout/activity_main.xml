<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="@dimen/screen_padding_h"
    android:paddingTop="@dimen/screen_padding_top"
    android:paddingEnd="@dimen/screen_padding_h">

    <!-- Scrolls sideways on phones; on TV everything fits and the spacer pushes speed/profile right. -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="true"
        android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginEnd="20dp"
            android:src="@mipmap/ic_launcher" />

        <Button
            android:id="@+id/btn_videos"
            style="@style/TvButton"
            android:text="@string/all_videos" />

        <Button
            android:id="@+id/btn_collections"
            style="@style/TvButton"
            android:text="@string/collections" />

        <Button
            android:id="@+id/btn_history"
            style="@style/TvButton"
            android:text="@string/history" />

        <Button
            android:id="@+id/btn_years"
            style="@style/TvButton"
            android:text="@string/years" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"
            android:minWidth="10dp" />

        <Button
            android:id="@+id/btn_speed"
            style="@style/TvButton"
            android:text="@string/speed" />

        <Button
            android:id="@+id/btn_profile"
            style="@style/TvButton"
            android:layout_marginEnd="0dp"
            android:maxWidth="260dp"
            android:singleLine="true"
            android:ellipsize="end"
            android:text="@string/sign_in" />
    </LinearLayout>
    </HorizontalScrollView>

    <TextView
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:layout_marginBottom="8dp"
        android:singleLine="true"
        android:ellipsize="end"
        android:textSize="@dimen/heading_size"
        android:textStyle="bold" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <GridView
            android:id="@+id/grid"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:drawSelectorOnTop="true"
            android:horizontalSpacing="@dimen/grid_spacing"
            android:listSelector="@drawable/grid_selector"
            android:columnWidth="@dimen/grid_column_width"
            android:numColumns="auto_fit"
            android:paddingTop="6dp"
            android:paddingBottom="24dp"
            android:scrollbars="none"
            android:stretchMode="columnWidth"
            android:verticalSpacing="@dimen/grid_spacing" />

        <ProgressBar
            android:id="@+id/loading"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_gravity="center"
            android:visibility="gone" />

        <TextView
            android:id="@+id/message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/button_bg"
            android:focusable="true"
            android:gravity="center"
            android:maxWidth="600dp"
            android:padding="20dp"
            android:textColor="@drawable/button_text"
            android:textSize="16sp"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
